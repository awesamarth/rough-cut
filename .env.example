# Copy to .dev.vars for local Next.js development.
NEXTJS_ENV=development
MEDIA_WORKER_URL=http://localhost:8788
MEDIA_WORKER_TOKEN=local-dev

# Cloud processing fails closed until explicitly configured and migration 0002 applied.
# These are app-wide admission limits, NOT a Cloudflare account spending cap.
# Failed operations retain reservations. Do not enable before reviewing current pricing.
CLOUD_TRANSCRIPTION_DAILY_MINUTES=0
CLOUD_EXPORTS_DAILY_LIMIT=0
# Rendered-output R2 overflow only. Keep disabled until prefix lifecycle is configured.
# Daily admission MiB (hard maximum 8192); failed attempts retain their reservation.
CLOUD_OUTPUT_DAILY_MIB=0
# Set to 1 only after enabling a two-day object expiry for rough-cut-output/.
CLOUD_OUTPUT_LIFECYCLE_READY=0
