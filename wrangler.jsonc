{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rough-cut",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rough-cut"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "rough-cut-next-opennext-cache"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "rough-cut-media"
    },
    {
      "binding": "OUTPUTS",
      "bucket_name": "rough-cut-outputs",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rough-cut-db",
      "database_id": "60e909d4-5c87-4f50-8637-17a3670f632b",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "MEDIA_WORKER_URL": "https://rough-cut-media.samarthsaxena1672003.workers.dev",
    "CLOUD_EXPORTS_DAILY_LIMIT": "0",
    "CLOUD_OUTPUT_DAILY_MIB": "8192",
    "CLOUD_OUTPUT_LIFECYCLE_READY": "1"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
