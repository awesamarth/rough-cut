{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rough-cut-improvements",
  "workers_dev": true,
  "routes": [
    { "pattern": "rough-cut.awesamarth.dev", "custom_domain": true }
  ],
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rough-cut-improvements"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "rough-cut-improvements-cache"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "rough-cut-improvements-media"
    },
    {
      "binding": "OUTPUTS",
      "bucket_name": "rough-cut-outputs",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rough-cut-improvements-db",
      "database_id": "893e5547-1671-4325-8ebf-66ad34eb93f1",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "CLOUD_EXPORTS_DAILY_LIMIT": "0",
    "CLOUD_TRANSCRIPTION_DAILY_MINUTES": "600",
    "CLOUD_OUTPUT_DAILY_MIB": "8192",
    "CLOUD_OUTPUT_LIFECYCLE_READY": "1"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
